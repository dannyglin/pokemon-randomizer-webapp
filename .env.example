# Copy to .env and adjust as needed. All values here are optional —
# docker-compose.yml falls back to sensible defaults if unset. Defaults are
# deliberately tight (sized for a 1GB-RAM host like a GCP e2-micro) — this
# app is scoped to Gen 1-5 ROMs only (.gb/.gbc/.gba/.nds), not 3DS.

# Hours a completed/failed job's files stay downloadable before the sweep deletes them.
JOB_RETENTION_HOURS=24

# Upload size cap, in bytes. Gen 1-5 ROMs are small.
MAX_UPLOAD_BYTES=67108864    # 64MB

# Per-IP job creation limit (jobs/hour).
RATE_LIMIT_JOBS_PER_HOUR=5

# How many randomization subprocesses the worker runs concurrently. Keep at
# 1 on a single-vCPU host — two concurrent JVMs will thrash badly.
WORKER_CONCURRENCY=1

# Hard wall-clock timeout per randomization subprocess, in ms.
JOB_TIMEOUT_MS=600000

# JVM heap for the randomizer subprocess. Gen 1-5 ROMs need far less than
# the 4096 the tool recommends for 3DS games (which this app doesn't support).
JAVA_HEAP_MB=384

# Container memory limits (Docker Compose deploy.resources.limits). Sized
# to fit api+worker+web+redis inside 1GB total with headroom for the OS —
# raise these if you're running on a bigger host.
API_MEMORY_LIMIT=200m
WORKER_MEMORY_LIMIT=600m

# Host port the web frontend is exposed on.
WEB_PORT=8080
