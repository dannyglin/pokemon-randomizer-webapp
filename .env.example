# Copy to .env and adjust as needed. All values here are optional —
# docker-compose.yml falls back to sensible defaults if unset.

# Hours a completed/failed job's files stay downloadable before the sweep deletes them.
JOB_RETENTION_HOURS=24

# Per-tier upload size caps, in bytes.
MAX_UPLOAD_BYTES_HANDHELD=67108864    # 64MB
MAX_UPLOAD_BYTES_3DS=4294967296       # 4GB

# Per-IP job creation limit (jobs/hour).
RATE_LIMIT_JOBS_PER_HOUR=5

# How many randomization subprocesses the worker runs concurrently.
WORKER_CONCURRENCY=2

# Hard wall-clock timeout per randomization subprocess, in ms.
JOB_TIMEOUT_MS=900000

# JVM heap for the randomizer subprocess (4096 recommended for 3DS games).
JAVA_HEAP_MB=4096

# Worker container memory limit — should comfortably exceed JAVA_HEAP_MB.
WORKER_MEMORY_LIMIT=6g

# Host port the web frontend is exposed on.
WEB_PORT=8080
